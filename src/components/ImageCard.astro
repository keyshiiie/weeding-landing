---
interface Props {
  title: string;
  image: any;
  href: string;
}

const { title, image, href } = Astro.props;
---

<a href={href} class="image-card">
  <img
    src={image.src}
    alt={title}
    class="image-card__img"
    loading="lazy"
  />
  <div class="image-card__overlay"></div>
  <h2 class="image-card__title">{title}</h2>
</a>